{
  "name": "@anayap10/pika-ui",
  "version": "0.1.1",
  "type": "module",
  "description": "A retro arcade design system — 8-bit looks, WCAG 2.2 AAA manners",
  "author": "Paola Anaya",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/anayap10/pika-ui.git"
  },
  "homepage": "https://github.com/anayap10/pika-ui#readme",
  "bugs": {
    "url": "https://github.com/anayap10/pika-ui/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "retro",
    "arcade",
    "wcag",
    "accessible",
    "a11y",
    "a11y-aaa"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --mode lib",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:a11y": "vitest run --project unit src/test/a11y.test.tsx",
    "test:storybook": "vitest run --project storybook",
    "test:all": "vitest run",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token=chpt_9c8e3674a6fb938",
    "prepublishOnly": "npm run lint && npm run test:coverage && npm run build",
    "publish": "npm publish --access public"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.1",
    "@sa11y/vitest": "^8.0.28",
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/addon-vitest": "^10.1.10",
    "@storybook/react-vite": "^10.1.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "chromatic": "^16.10.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.10",
    "globals": "^16.5.0",
    "jsdom": "26.1.0",
    "playwright": "^1.57.0",
    "storybook": "^10.1.10",
    "terser": "^5.51.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}
